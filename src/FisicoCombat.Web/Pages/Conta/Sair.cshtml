@page
@model FisicoCombat.Web.Pages.Conta.SairModel
@{
    ViewData["Title"] = "Sair";
}

<h1>Sair</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p>Deseja sair da sua conta neste dispositivo?</p>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <button type="submit" class="btn btn-primary">Sair</button>
        <a class="btn btn-outline-primary ms-2" asp-page="/Index">Cancelar</a>
    </form>
}
else
{
    <p>Você não está conectado.</p>
    <a class="btn btn-primary" asp-page="/Index">Voltar ao início</a>
}
