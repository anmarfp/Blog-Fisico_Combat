@page
@model FisicoCombat.Web.Pages.Conta.EntrarModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <h1 class="mb-4">Entrar</h1>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Senha" class="form-label"></label>
                <input asp-for="Input.Senha" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Senha" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.Lembrar" class="form-check-input" />
                <label asp-for="Input.Lembrar" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>

        <p class="mt-3">
            Ainda não tem conta?
            <a asp-page="/Conta/Cadastrar" asp-route-returnUrl="@Model.ReturnUrl">Crie a sua</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
