@page
@model IndexModel
@{
    ViewData["Title"] = "Professores";
}

<p><a asp-page="/Admin/Index">&larr; Painel</a></p>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Professores</h1>
    <a class="btn btn-primary" asp-page="Criar">Novo professor</a>
</div>

@if (Model.Professores.Count == 0)
{
    <p>Nenhum professor cadastrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Foto</th>
                    <th scope="col">Nome</th>
                    <th scope="col">Modalidades</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Professores)
                {
                    <tr>
                        <td>
                            @if (p.FotoCaminho is not null)
                            {
                                <img src="@p.FotoCaminho" alt="@p.Nome" class="foto-professor rounded" width="56" height="56" />
                            }
                            else
                            {
                                <span class="text-muted">Sem foto</span>
                            }
                        </td>
                        <td>@p.Nome</td>
                        <td>@(p.Modalidades.Count == 0 ? "—" : string.Join(", ", p.Modalidades.Select(m => m.Nome).Order()))</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Editar" asp-route-id="@p.Id">Editar <span class="visually-hidden">@p.Nome</span></a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="Excluir" asp-route-id="@p.Id">Excluir <span class="visually-hidden">@p.Nome</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
