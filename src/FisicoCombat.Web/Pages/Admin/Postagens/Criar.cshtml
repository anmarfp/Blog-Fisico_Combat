@page
@model CriarModel
@{
    ViewData["Title"] = "Nova postagem";
}

<h1>Nova postagem</h1>

<form method="post" enctype="multipart/form-data" class="col-lg-8">
    <partial name="_Formulario" model="Model" />
    <button type="submit" class="btn btn-primary">Publicar</button>
    <a class="btn btn-outline-secondary" asp-page="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
